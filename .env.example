# ============================================================================
# Voice Agent — Environment Configuration
# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
# ============================================================================

# --- General ---
APP_ENV=development                       # development | production
APP_HOST=0.0.0.0
APP_PORT=8000                             # FastAPI dashboard + Twilio webhooks
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR

# --- Business Context ---
# Which business is this agent serving? tuition | pg | shared
BUSINESS_MODE=shared
DEFAULT_LANGUAGE=ta-IN                    # ta-IN (Tamil) | en-IN (Indian English)

# --- Groq LLM (FREE TIER — get key at https://console.groq.com) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.4
GROQ_MAX_TOKENS=400
GROQ_STREAM=true

# --- Edge-TTS (100% FREE — no key needed) ---
TTS_VOICE=ta-IN-PallaviNeural             # ta-IN-PallaviNeural (female) | ta-IN-ValluvarNeural (male)
TTS_RATE=+5%                              # Speak slightly faster for snappy feel
TTS_VOLUME=+0%
TTS_PITCH=+0Hz

# --- Faster-Whisper STT (100% FREE — runs locally) ---
WHISPER_MODEL_SIZE=small                  # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu                        # cpu | cuda
WHISPER_COMPUTE_TYPE=int8                 # int8 | int8_float16 | float16 | float32
WHISPER_LANGUAGE=ta                       # Force Tamil decoding (set None for auto-detect)
WHISPER_VAD_FILTER=true                   # Filter non-speech

# --- Twilio (Telephony + WhatsApp) ---
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+12345678901          # Your Twilio-purchased number (E.164)
TWILIO_WHATSAPP_NUMBER=whatsapp:+12345678901  # WhatsApp-enabled Twilio number

# --- Public webhook URL (use ngrok / cloudflared in dev) ---
# Twilio needs to reach your FastAPI server. Use:
#   ngrok http 8000   →   https://abc123.ngrok.io
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok.io

# --- Database ---
DATABASE_PATH=/home/z/my-project/voice_agent.db

# --- Recordings ---
RECORDINGS_DIR=/home/z/my-project/download/recordings

# --- Lead Qualification Thresholds ---
LEAD_HOT_SCORE=80
LEAD_WARM_SCORE=50

# --- Tuition Centre Business Info (edit these!) ---
TUITION_NAME=Vidhya Tuition Centre
TUITION_ADDRESS=No.42, Gandhipuram, Coimbatore, Tamil Nadu 641012
TUITION_PHONE=+914225555555
TUITION_LOCATION_PIN=https://maps.google.com/?q=11.0168,76.9558
TUITION_FEES_PDF_PATH=/home/z/my-project/assets/tuition_fees.pdf
TUITION_SUBJECTS= Maths, Science, English (Classes 6-12), NEET & JEE Foundation
TUITION_BATCHES= Weekday 5-7 PM, Weekend 10 AM-12 PM
TUITION_FEES= ₹1500/month for school tuition, ₹3500/month for NEET/JEE foundation
TUITION_TRIAL=true

# --- Gents PG Business Info (edit these!) ---
PG_NAME=Shanthi Gents PG
PG_ADDRESS=3rd Floor, Crosscut Road, Gandhipuram, Coimbatore 641012
PG_PHONE=+914225555556
PG_LOCATION_PIN=https://maps.google.com/?q=11.0186,76.9725
PG_FEES_PDF_PATH=/home/z/my-project/assets/pg_fees.pdf
PG_RENT= ₹6500/month (sharing), ₹9500/month (single)
PG_DEPOSIT= 2 months refundable
PG_AMENITIES= WiFi, AC, 3 meals, hot water, laundry, 24/7 security
PG_VACANCY= 2 sharing rooms available from next month
